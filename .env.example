# ─────────────────────────────────────────
# 🔐 SEGURIDAD
# ─────────────────────────────────────────
# Llave secreta de Django/JWT (mínimo 50 chars en producción)
SECRET_KEY=clave-segura-que-es-mayor-de-32-caracteres

# Modo debug (True solo en desarrollo, False en producción)
DEBUG=True

# ─────────────────────────────────────────
# 🌐 RED Y CORS
# ─────────────────────────────────────────
# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────
# 🗄️ BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_HOST=db
DB_PORT=5432

# ─────────────────────────────────────────
# ⚡ REDIS (caché y sesiones)
# ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────────
# 🛡️ CABECERAS DE SEGURIDAD HTTPS
# (dejar en False/0 en desarrollo local)
# ─────────────────────────────────────────
# Redirige HTTP → HTTPS automáticamente
SECURE_SSL_REDIRECT=False

# Cookies solo accesibles por HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Tiempo en segundos de HSTS (0 = desactivado, 31536000 = 1 año en prod)
SECURE_HSTS_SECONDS=0