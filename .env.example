# ─────────────────────────────────────────
# 🔐 SEGURIDAD
# ─────────────────────────────────────────
# Llave secreta de Django/JWT (mínimo 50 chars en producción)
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# O sin Django:   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=clave-segura-que-es-mayor-de-32-caracteres

# Modo debug (True solo en desarrollo, False en producción)
DEBUG=True

# ─────────────────────────────────────────
# 🌐 RED Y CORS
# ─────────────────────────────────────────
# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Patrones regex de orígenes permitidos por CORS (separados por |)
# Útil para URLs dinámicas como previews de Vercel u otros entornos de staging.
# Ejemplo: ^https://mi-app-[a-z0-9\-]+-mi-usuario\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# ─────────────────────────────────────────
# 🗄️ BASE DE DATOS (PostgreSQL)
# ─────────────────────────────────────────
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_HOST=db
DB_PORT=5432

# ─────────────────────────────────────────
# ⚡ REDIS (caché y sesiones)
# ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────────────────────────────────
# 🚪 PUERTOS EXPUESTOS AL HOST
# Cambia estos valores si los puertos ya están ocupados en tu máquina
# ─────────────────────────────────────────
# Puerto de acceso a la aplicación principal (vía Nginx)
NGINX_PORT=8080

# Escribe la dirección URL de tu API aquí
VITE_API_URL=http://localhost:8080